{
  "appId": "social.fairshare.union",
  "appName": "Union",
  "webDir": "www",
  "ios": {
    "backgroundColor": "#3a7ca5"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
